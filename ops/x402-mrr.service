[Unit]
Description=x402-mrr settled leaderboard (loopback only)
Documentation=file:///home/twzrd/x402-mrr/README.md
After=network-online.target
# Loopback origin for settled.twzrd.xyz. Host bind stays 127.0.0.1.
# Public exposure is the battleship tunnel ingress, not this unit.

[Service]
Type=simple
WorkingDirectory=%h/x402-mrr
Environment=BIND=127.0.0.1
Environment=PORT=4040
Environment=DATA_DIR=%h/x402-mrr/data
Environment=INTEL_BASE=https://intel.twzrd.xyz
Environment=PATH=%h/.local/bin:/usr/bin
ExecStart=%h/.local/bin/node dist/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
